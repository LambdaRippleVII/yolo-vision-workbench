{
  "name": "yolo-vision-workbench-desktop",
  "version": "0.4.1",
  "private": true,
  "description": "YOLO Vision Workbench desktop shell (Electron + Vue3)",
  "main": "out/main/index.js",
  "author": "LambdaRippleVII",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "prepare:python-runtime": "node scripts/prepare-python-runtime.mjs",
    "dist": "npm run prepare:python-runtime && electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  },
  "build": {
    "appId": "com.lambdaripple.yolovisionworkbench",
    "productName": "YOLO 视觉工作台",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!.venv/**",
          "!**/__pycache__/**",
          "!wheels/**"
        ]
      },
      {
        "from": "../models",
        "to": "models",
        "filter": [
          "**/*",
          "!**/*.pt"
        ]
      },
      {
        "from": "vendor/python-embed/runtime",
        "to": "python-embed/runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "app-icon.ico"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "YOLO-Vision-Workbench-${version}-${os}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "displayLanguageSelector": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "include": "build/installer.nsh",
      "uninstallDisplayName": "YOLO 视觉工作台",
      "shortcutName": "YOLO 视觉工作台"
    }
  }
}
